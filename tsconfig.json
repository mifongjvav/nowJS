{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "moduleResolution": "Bundler",
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "checkJs": false,
        "isolatedModules": true,
        "noEmit": true,
        // The legacy UI/game surface still uses implicit global state; its core TS modules are checked by tsconfig.core.json.
        "noCheck": true,
        "strict": false
    },
    "include": ["src/**/*.ts"]
}
